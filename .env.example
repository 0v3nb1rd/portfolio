# Copy to `.env.local` for local runs. Never commit `.env*` files except this template.

NEXT_PUBLIC_SANITY_DATASET=''
NEXT_PUBLIC_SANITY_PROJECT_ID=''

# Contact form (server-side only — OK to keep unset in CI that does not send mail)
RESEND_API_KEY=''

# Optional: sender for contact form emails. Requires the domain to be verified
# in the Resend dashboard. Falls back to the resend.dev sandbox sender.
# RESEND_FROM='No-Reply <no-reply@ovbi.dev>'

NEXT_PUBLIC_DEFAULT_THEME=''

# Optional Sanity API version override (defaults in sanity/env.ts)
# NEXT_PUBLIC_SANITY_API_VERSION=

# Optional: Sanity Live / draft preview (sanity/lib/live.ts → defineLive).
# Use a Sanity token with Viewer / read-only access to this dataset—not a token with write access.
# SANITY_API_READ_TOKEN=
